# ⚠️ CREDENTIALS - KEEP SECURE - DO NOT COMMIT TO GIT ⚠️

# ANGEL ONE API
ANGEL_ONE_API_KEY=your_angel_one_api_key_here
ANGEL_ONE_CLIENT_ID=your_angel_one_client_id_here
ANGEL_ONE_CLIENT_SECRET=your_angel_one_client_secret_here
ANGEL_ONE_USER_ID=your_angel_one_user_id_here
ANGEL_ONE_PASSWORD=your_angel_one_password_here
ANGEL_ONE_TOTP_SECRET=your_angel_one_totp_secret_here

# Optional: If you already generated SmartAPI JWT/feed tokens, you can set these.
# The system can use them to avoid re-authentication when supported.
ANGEL_ONE_AUTH_TOKEN=your_angel_one_auth_token_here
ANGEL_ONE_FEED_TOKEN=your_angel_one_feed_token_here

# DHAN PLATFORM
DHAN_API_KEY=your_dhan_api_key_here
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# TRADING PARAMETERS
TRADING_SYMBOL=SILVER    # MCX Silver symbol
TRADING_EXCHANGE=MCX     # Exchange
PAPER_TRADE_ENABLED=true # Set to false for live trading (NOT RECOMMENDED)
MIN_CONFIDENCE=0.65      # Minimum signal confidence (0-1)
MAX_POSITION_SIZE=5      # Max contracts per trade
STOP_LOSS_PCT=1.5        # Stop loss percentage
PROFIT_TARGET_PCT=2.0    # Profit target percentage
FETCH_INTERVAL_SECONDS=5 # Real-time data fetch interval (seconds)

# DATA MODE
EXTERNAL_DATA_ONLY=true  # true = no fallback to local replay/mock data

# Dashboard live quote: exact MCX futures symbol (resolved via Angel search before May/Jul cascade)
LIVE_QUOTE_TRADINGSYMBOL=SILVER05MAY26FUT

# Angel One: minimum seconds between each search/quote call (avoids "exceeding access rate")
ANGEL_API_MIN_INTERVAL_SEC=0.55

# Integration GET /api/market/live: serve last successful JSON for this many seconds (fewer broker calls)
MARKET_LIVE_CACHE_TTL_SEC=8

# MCX quote/LTP from Angel is often in paise (large ints); divide by this for ₹ display. Use 1 if your feed is already rupees.
ANGEL_MCX_LTP_DIVISOR=100

# LLM (optional — for LLM strategy; llm_engine uses mock if unset)
# OPENAI_API_KEY=
# LLM_API_KEY=
#
# LLM provider (OpenAI-compatible; OpenRouter by default)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=350

# If true, the bot will throw an error when LLM_API_KEY / OPENAI_API_KEY is not set.
# Otherwise it returns a safe HOLD decision.
REQUIRE_LLM_API_KEY=false

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
